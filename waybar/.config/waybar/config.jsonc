// Waybar configuration for Hyprland.
{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-left": 5,
    "margin-right": 5,
    "spacing": 0,
    "fixed-center": true,
    "expand-left": true,

    "modules-left": ["custom/mpris", "custom/spacer", "hyprland/workspaces"],
    "modules-center": ["custom/clock"],
    "modules-right": [
        "group/tools",
        "group/hardware",
        "group/status",
        "custom/notifications",
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by": "number",
        "enable-bar-scroll": false,
        "tooltip": false,
    },
    "group/tools": {
        "orientation": "horizontal",
        "modules": ["custom/screenshot", "custom/colorpicker"],
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory"],
    },
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "custom/wifi",
            "custom/bluetooth",
            "custom/battery",
        ],
    },
    "custom/screenshot": {
        "format": " 󰄀",
        "tooltip": true,
        "tooltip-format": "擷取選取區域",
        "on-click": "bash ~/.config/hypr/scripts/screenshot-area.sh",
    },
    "custom/colorpicker": {
        "format": " 󰈋",
        "tooltip": true,
        "tooltip-format": "取色並複製到剪貼簿",
        "on-click": "hyprpicker -a",
    },
    "cpu": {
        "interval": 5,
        "format": "CPU {usage:>2}%",
        "tooltip": false,
    },
    "memory": {
        "interval": 5,
        "format": "RAM {used:>4.1f}G",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    },
    "pulseaudio": {
        "format": "{icon} {volume:>3}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "default": ["", "", ""],
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    },
    "custom/battery": {
        "return-type": "json",
        "exec": "bash ~/.config/hypr/scripts/battery-status.sh",
        "interval": 30,
        "format": "{text}",
        "hide-empty-text": true,
    },
    "custom/mpris": {
        "return-type": "json",
        "exec": "bash ~/.config/hypr/scripts/waybar-mpris.sh",
        "interval": 2,
        "format": "{text}",
        "escape": true,
        "max-length": 60,
        "on-click": "bash ~/.config/hypr/scripts/waybar-mpris.sh play-pause",
        "on-click-right": "bash ~/.config/hypr/scripts/waybar-mpris.sh previous",
        "on-click-middle": "bash ~/.config/hypr/scripts/waybar-mpris.sh next",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    },
    "custom/spacer": {
        "format": " ",
        "expand": true,
        "tooltip": false,
    },
    "custom/wifi": {
        "return-type": "json",
        "exec": "bash ~/.config/hypr/scripts/wifi-status.sh",
        "interval": 5,
        "format": "{text}",
        "min-length": 16,
        "max-length": 16,
        "align": 0.5,
        "on-click": "bash ~/.config/hypr/scripts/wifi-menu.sh",
        "on-click-right": "kcmshell6 kcm_networkmanagement",
    },
    "custom/bluetooth": {
        "return-type": "json",
        "exec": "bash ~/.config/hypr/scripts/bt-status.sh",
        "interval": 5,
        "format": "{text}",
        "min-length": 16,
        "max-length": 16,
        "align": 0.5,
        "on-click": "bash ~/.config/hypr/scripts/bluetooth-menu.sh",
        "on-click-right": "kcmshell6 kcm_bluetooth",
    },
    "custom/clock": {
        "return-type": "json",
        "exec": "bash ~/.config/hypr/scripts/waybar-clock.sh",
        "interval": 30,
        "format": "{text}",
        "on-click": "swaync-client -t -sw",
    },
    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification": " ",
            "none": " 󰂛",
            "dnd-notification": " ",
            "dnd-none": " ",
            "inhibited-notification": " ",
            "inhibited-none": " ",
        },
        "tooltip": true,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
    },
}
