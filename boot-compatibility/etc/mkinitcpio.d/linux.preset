# mkinitcpio preset file for the linux package.
#
# The default UKI is optimized for the current host. The fallback UKI omits
# autodetect, so it remains usable after moving the disk to different hardware.

ALL_kver="/boot/vmlinuz-linux"

PRESETS=('default' 'fallback')

default_uki="/boot/EFI/Linux/arch-linux.efi"
default_options="--splash /usr/share/systemd/bootctl/splash-arch.bmp"

fallback_uki="/boot/EFI/Linux/arch-linux-fallback.efi"
fallback_options="-S autodetect --cmdline /etc/kernel/cmdline-portable --osrelease /etc/kernel/os-release-fallback"
