#!/bin/sh
set -eu

# Generate explicit entries for mkinitcpio UKIs. GRUB's 10_linux generator
# detects separate kernels and initramfs images, but not UKIs.

esp_uuid="$(grub-probe --target=fs_uuid /boot)"

cat <<EOF
menuentry 'Arch Linux (UKI)' {
    search --no-floppy --fs-uuid --set=esp ${esp_uuid}
    chainloader (\$esp)/EFI/Linux/arch-linux.efi
}

menuentry 'Arch Linux (fallback UKI)' {
    search --no-floppy --fs-uuid --set=esp ${esp_uuid}
    chainloader (\$esp)/EFI/Linux/arch-linux-fallback.efi
}
EOF
