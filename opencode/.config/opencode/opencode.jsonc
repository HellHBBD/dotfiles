{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-terra",
    "small_model": "openai/gpt-5.6-luna",
    "permission": {
        "edit": "allow",
        "external_directory": "ask",
        "doom_loop": "ask",
        "task": {
            "*": "allow",
            "critical-reviewer": "deny",
        },
        "bash": {
            "*": "allow",

            "sudo": "deny",
            "sudo *": "deny",
            "* sudo *": "deny",
            "sudoedit": "deny",
            "sudoedit *": "deny",
            "* sudoedit *": "deny",
            "doas": "deny",
            "doas *": "deny",
            "* doas *": "deny",
            "su": "deny",
            "su *": "deny",
            "* su *": "deny",
            "pkexec": "deny",
            "pkexec *": "deny",
            "* pkexec *": "deny",
            "run0": "deny",
            "run0 *": "deny",
            "* run0 *": "deny",

            "rm *": "ask",
            "rmdir *": "ask",
            "shred *": "ask",

            "chmod *": "ask",
            "chown *": "ask",
            "chgrp *": "ask",

            "dd *": "ask",
            "mkfs*": "ask",
            "fdisk *": "ask",
            "cfdisk *": "ask",
            "sfdisk *": "ask",
            "parted *": "ask",
            "wipefs *": "ask",

            "git commit*": "ask",
            "git push*": "ask",
            "git reset --hard*": "ask",
            "git clean*": "ask",
            "git restore*": "ask",
            "git checkout --*": "ask",
            "git branch -D*": "ask",
            "git rebase*": "ask",
            "git merge*": "ask",
            "git stash drop*": "ask",
            "git stash clear*": "ask",
            "git worktree remove*": "ask",

            "gh pr merge*": "ask",
            "gh release create*": "ask",
            "gh release delete*": "ask",
            "gh repo delete*": "ask",
            "gh workflow run*": "ask",

            "apt install*": "ask",
            "apt remove*": "ask",
            "apt-get install*": "ask",
            "apt-get remove*": "ask",
            "dnf install*": "ask",
            "dnf remove*": "ask",
            "pacman -S*": "ask",
            "pacman -R*": "ask",
            "pacman -U*": "ask",
            "yay -S*": "ask",
            "yay -R*": "ask",
            "paru -S*": "ask",
            "paru -R*": "ask",

            "npm install -g*": "ask",
            "npm i -g*": "ask",
            "pnpm add -g*": "ask",
            "yarn global add*": "ask",
            "bun add -g*": "ask",
            "cargo install*": "ask",
            "pip install --user*": "ask",
            "python -m pip install --user*": "ask",
            "pipx install*": "ask",
            "uv tool install*": "ask",
            "gem install*": "ask",
            "composer global require*": "ask",

            "systemctl start *": "ask",
            "systemctl stop *": "ask",
            "systemctl restart *": "ask",
            "systemctl enable *": "ask",
            "systemctl disable *": "ask",
            "systemctl mask *": "ask",
            "systemctl unmask *": "ask",
            "systemctl daemon-reload*": "ask",
            "reboot*": "ask",
            "shutdown*": "ask",
            "poweroff*": "ask",

            "docker system prune*": "ask",
            "docker volume prune*": "ask",
            "docker volume rm*": "ask",
            "docker rm*": "ask",
            "docker compose down -v*": "ask",
            "kubectl apply*": "ask",
            "kubectl delete*": "ask",
            "helm upgrade*": "ask",
            "helm uninstall*": "ask",
            "terraform apply*": "ask",
            "terraform destroy*": "ask",

            "curl *|*sh*": "ask",
            "curl *|*bash*": "ask",
            "wget *|*sh*": "ask",
            "wget *|*bash*": "ask",
        },
        "skill": {
            "*": "ask",
            "core-*": "allow",
            "project-*": "allow",
            "vendor-*": "ask",
            "experimental-*": "deny",
            "superpower-brainstorming": "allow",
            "superpower-systematic-debugging": "allow",
            "superpower-receiving-code-review": "allow",
            "superpower-dispatching-parallel-agents": "allow",
            "superpower-plan-writing": "deny",
            "superpower-skill-authoring": "deny",
            "vendor-wshobson-debugging-strategies": "allow",
            "vendor-wshobson-code-review-excellence": "allow",
            "vendor-wshobson-git-advanced-workflows": "allow",
            "vendor-wshobson-sql-optimization-patterns": "allow",
            "vendor-wshobson-visual-design-foundations": "allow",
            "vendor-wshobson-design-system-patterns": "allow",
            "vendor-wshobson-accessibility-compliance": "allow",
            "vendor-wshobson-responsive-design": "allow",
            "vendor-wshobson-interaction-design": "allow",
        },
    },
    "agent": {
        "general": {
            "hidden": true,
        },
        "explore": {
            "hidden": true,
        },
        "build": {
            "model": "openai/gpt-5.6-terra",
            "options": {
                "reasoningEffort": "medium",
            },
            "permission": {
                "skill": {
                    "*": "ask",
                    "core-*": "allow",
                    "project-*": "allow",
                    "vendor-*": "ask",
                    "experimental-*": "deny",
                    "superpower-brainstorming": "allow",
                    "superpower-systematic-debugging": "allow",
                    "superpower-receiving-code-review": "allow",
                    "superpower-dispatching-parallel-agents": "allow",
                    "superpower-plan-writing": "deny",
                    "superpower-skill-authoring": "deny",
                    "vendor-wshobson-debugging-strategies": "allow",
                    "vendor-wshobson-code-review-excellence": "allow",
                    "vendor-wshobson-git-advanced-workflows": "allow",
                    "vendor-wshobson-sql-optimization-patterns": "allow",
                    "vendor-wshobson-visual-design-foundations": "allow",
                    "vendor-wshobson-design-system-patterns": "allow",
                    "vendor-wshobson-accessibility-compliance": "allow",
                    "vendor-wshobson-responsive-design": "allow",
                    "vendor-wshobson-interaction-design": "allow",
                },
            },
        },
        "plan": {
            "model": "openai/gpt-5.6-sol",
            "options": {
                "reasoningEffort": "high",
            },
            "permission": {
                "skill": {
                    "*": "deny",
                    "core-analysis-*": "allow",
                    "core-architecture-*": "allow",
                    "project-planning-*": "allow",
                    "superpower-plan-writing": "allow",
                    "superpower-skill-authoring": "deny",
                    "vendor-wshobson-visual-design-foundations": "allow",
                    "vendor-wshobson-design-system-patterns": "allow",
                    "vendor-wshobson-accessibility-compliance": "allow",
                    "vendor-wshobson-responsive-design": "allow",
                    "vendor-wshobson-interaction-design": "allow",
                },
                "task": {
                    "*": "deny",
                    "critical-reviewer": "deny",
                },
            },
        },
    },
    "plugin": ["opencode-mobile@latest"],
}
