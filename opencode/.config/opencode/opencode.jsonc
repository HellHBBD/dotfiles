{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-terra",
    "small_model": "openai/gpt-5.6-luna",
    "permission": {
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            ".ssh/**": "deny",
            "*/.ssh/**": "deny",
            ".gnupg/**": "deny",
            "*/.gnupg/**": "deny",
            ".aws/**": "deny",
            "*/.aws/**": "deny",
            ".azure/**": "deny",
            "*/.azure/**": "deny",
            ".config/gcloud/**": "deny",
            "*/.config/gcloud/**": "deny",
            ".config/gh/**": "deny",
            "*/.config/gh/**": "deny",
            ".local/share/opencode/auth.json": "deny",
            "*/.local/share/opencode/auth.json": "deny",
        },
        "glob": "allow",
        "grep": "ask",
        "list": "allow",
        "edit": "ask",
        "external_directory": {
            "*": "allow",
            "~/.ssh/**": "deny",
            "~/.gnupg/**": "deny",
            "~/.aws/**": "deny",
            "~/.azure/**": "deny",
            "~/.config/gcloud/**": "deny",
            "~/.config/gh/**": "deny",
            "~/.local/share/opencode/**": "deny",
        },
        "doom_loop": "ask",
        "task": {
            "*": "allow",
            "critical-reviewer": "deny",
        },
        "bash": {
            "*": "ask",

            "pwd": "allow",
            "whoami": "allow",
            "id": "allow",
            "groups": "allow",
            "uname": "allow",
            "uname *": "allow",
            "command -v *": "allow",
            "type *": "allow",
            "basename *": "allow",
            "dirname *": "allow",
            "readlink *": "allow",
            "realpath *": "allow",

            "git status*": "allow",
            "git diff*": "allow",
            "git show*": "allow",
            "git log*": "allow",
            "git rev-parse*": "allow",
            "git rev-list*": "allow",
            "git branch --show-current*": "allow",
            "git branch --list*": "allow",
            "git tag --list*": "allow",
            "git describe*": "allow",
            "git name-rev*": "allow",
            "git merge-base*": "allow",
            "git ls-files*": "allow",
            "git ls-tree*": "allow",
            "git worktree list*": "allow",
            "git check-ignore*": "allow",
            "git check-attr*": "allow",
            "git stash list*": "allow",
            "git stash show*": "allow",
            "git reflog show*": "allow",
            "git --version*": "allow",

            "rustc --version*": "allow",
            "cargo --version*": "allow",
            "rustup show active-toolchain*": "allow",
            "python --version*": "allow",
            "python3 --version*": "allow",
            "uv --version*": "allow",
            "node --version*": "allow",
            "npm --version*": "allow",
            "pnpm --version*": "allow",
            "bun --version*": "allow",
            "go version*": "allow",
            "gcc --version*": "allow",
            "clang --version*": "allow",
            "cmake --version*": "allow",
            "ninja --version*": "allow",
            "dx --version*": "allow",
            "opencode --version*": "allow",

            "*;*": "ask",
            "*&&*": "ask",
            "*||*": "ask",
            "*>*": "ask",
            "*<*": "ask",
            "*|*": "ask",
            "*$(*": "ask",
            "*`*": "ask",
            "tee *": "ask",

            // Approval-gated mutation
            "rm *": "ask",
            "rmdir *": "ask",
            "chmod *": "ask",
            "chown *": "ask",
            "chgrp *": "ask",

            "git commit*": "ask",
            "git push*": "ask",
            "git reset --hard*": "ask",
            "git clean*": "ask",
            "git restore*": "ask",
            "git checkout --*": "ask",
            "git branch -D*": "ask",
            "git rebase*": "ask",
            "git merge*": "ask",
            "git stash drop*": "ask",
            "git stash clear*": "ask",
            "git worktree remove*": "ask",

            "gh pr merge*": "ask",
            "gh release create*": "ask",
            "gh workflow run*": "ask",

            "apt install*": "ask",
            "apt remove*": "ask",
            "apt upgrade*": "ask",
            "apt-get install*": "ask",
            "apt-get remove*": "ask",
            "apt-get upgrade*": "ask",
            "apt-get dist-upgrade*": "ask",
            "dnf install*": "ask",
            "dnf remove*": "ask",
            "dnf upgrade*": "ask",
            "pacman -S*": "ask",
            "pacman -R*": "ask",
            "pacman -U*": "ask",
            "yay -S*": "ask",
            "yay -R*": "ask",
            "paru -S*": "ask",
            "paru -R*": "ask",

            "npm install -g*": "ask",
            "npm i -g*": "ask",
            "pnpm add -g*": "ask",
            "yarn global add*": "ask",
            "bun add -g*": "ask",
            "cargo install*": "ask",
            "pip install --user*": "ask",
            "python -m pip install --user*": "ask",
            "pipx install*": "ask",
            "uv tool install*": "ask",
            "gem install*": "ask",
            "composer global require*": "ask",

            "systemctl start *": "ask",
            "systemctl stop *": "ask",
            "systemctl restart *": "ask",
            "systemctl enable *": "ask",
            "systemctl disable *": "ask",
            "systemctl mask *": "ask",
            "systemctl unmask *": "ask",
            "systemctl daemon-reload*": "ask",
            "systemctl --user start *": "ask",
            "systemctl --user stop *": "ask",
            "systemctl --user restart *": "ask",
            "systemctl --user enable *": "ask",
            "systemctl --user disable *": "ask",
            "systemctl --user mask *": "ask",
            "systemctl --user unmask *": "ask",
            "systemctl --user daemon-reload*": "ask",
            "reboot*": "ask",
            "shutdown*": "ask",
            "poweroff*": "ask",

            "docker system prune*": "ask",
            "docker volume prune*": "ask",
            "docker volume rm*": "ask",
            "docker rm*": "ask",
            "docker compose down -v*": "ask",
            "kubectl apply*": "ask",
            "kubectl delete*": "ask",
            "helm upgrade*": "ask",
            "helm uninstall*": "ask",
            "terraform apply*": "ask",

            // Explicit approved command exceptions

            // Hard deny
            "sudo": "deny",
            "sudo *": "deny",
            "* sudo *": "deny",
            "sudoedit": "deny",
            "sudoedit *": "deny",
            "* sudoedit *": "deny",
            "doas": "deny",
            "doas *": "deny",
            "* doas *": "deny",
            "su": "deny",
            "su *": "deny",
            "* su *": "deny",
            "pkexec": "deny",
            "pkexec *": "deny",
            "* pkexec *": "deny",
            "run0": "deny",
            "run0 *": "deny",
            "* run0 *": "deny",
            "shred *": "deny",
            "dd *": "deny",
            "mkfs*": "deny",
            "fdisk *": "deny",
            "cfdisk *": "deny",
            "sfdisk *": "deny",
            "parted *": "deny",
            "wipefs *": "deny",
            "gh release delete*": "deny",
            "gh repo delete*": "deny",
            "terraform destroy*": "deny",
            "curl *|*sh*": "deny",
            "curl *|*bash*": "deny",
            "wget *|*sh*": "deny",
            "wget *|*bash*": "deny",
        },
        "skill": {
            "*": "ask",
            "core-*": "allow",
            "project-*": "allow",
            "vendor-*": "ask",
            "experimental-*": "deny",
            "superpower-brainstorming": "allow",
            "superpower-systematic-debugging": "allow",
            "superpower-receiving-code-review": "allow",
            "superpower-dispatching-parallel-agents": "allow",
            "superpower-plan-writing": "deny",
            "superpower-skill-authoring": "deny",
            "vendor-wshobson-debugging-strategies": "allow",
            "vendor-wshobson-code-review-excellence": "allow",
            "vendor-wshobson-git-advanced-workflows": "allow",
            "vendor-wshobson-sql-optimization-patterns": "allow",
            "vendor-wshobson-visual-design-foundations": "allow",
            "vendor-wshobson-design-system-patterns": "allow",
            "vendor-wshobson-accessibility-compliance": "allow",
            "vendor-wshobson-responsive-design": "allow",
            "vendor-wshobson-interaction-design": "allow",
        },
    },
    "agent": {
        "general": {
            "hidden": true,
        },
        "explore": {
            "hidden": true,
        },
        "build": {
            "model": "openai/gpt-5.6-terra",
            "options": {
                "reasoningEffort": "medium",
            },
            "permission": {
                "edit": {
                    "*": "allow",
                    "../*": "ask",
                },
                "skill": {
                    "*": "ask",
                    "core-*": "allow",
                    "project-*": "allow",
                    "vendor-*": "ask",
                    "experimental-*": "deny",
                    "superpower-brainstorming": "allow",
                    "superpower-systematic-debugging": "allow",
                    "superpower-receiving-code-review": "allow",
                    "superpower-dispatching-parallel-agents": "allow",
                    "superpower-plan-writing": "deny",
                    "superpower-skill-authoring": "deny",
                    "vendor-wshobson-debugging-strategies": "allow",
                    "vendor-wshobson-code-review-excellence": "allow",
                    "vendor-wshobson-git-advanced-workflows": "allow",
                    "vendor-wshobson-sql-optimization-patterns": "allow",
                    "vendor-wshobson-visual-design-foundations": "allow",
                    "vendor-wshobson-design-system-patterns": "allow",
                    "vendor-wshobson-accessibility-compliance": "allow",
                    "vendor-wshobson-responsive-design": "allow",
                    "vendor-wshobson-interaction-design": "allow",
                },
            },
        },
        "plan": {
            "model": "openai/gpt-5.6-sol",
            "options": {
                "reasoningEffort": "high",
            },
            "permission": {
                "edit": "deny",
                "skill": {
                    "*": "deny",
                    "core-analysis-*": "allow",
                    "core-architecture-*": "allow",
                    "project-planning-*": "allow",
                    "superpower-plan-writing": "allow",
                    "superpower-skill-authoring": "deny",
                    "vendor-wshobson-visual-design-foundations": "allow",
                    "vendor-wshobson-design-system-patterns": "allow",
                    "vendor-wshobson-accessibility-compliance": "allow",
                    "vendor-wshobson-responsive-design": "allow",
                    "vendor-wshobson-interaction-design": "allow",
                },
                "task": {
                    "*": "deny",
                    "critical-reviewer": "deny",
                },
            },
        },
    },
    "plugin": ["opencode-mobile@latest"],
}
