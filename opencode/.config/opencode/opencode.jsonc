{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-terra",
    "small_model": "openai/gpt-5.6-luna",
    "permission": {
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow",
            ".ssh/**": "deny",
            "*/.ssh/**": "deny",
            ".gnupg/**": "deny",
            "*/.gnupg/**": "deny",
            ".aws/**": "deny",
            "*/.aws/**": "deny",
            ".azure/**": "deny",
            "*/.azure/**": "deny",
            ".config/gcloud/**": "deny",
            "*/.config/gcloud/**": "deny",
            ".config/gh/**": "deny",
            "*/.config/gh/**": "deny",
            ".local/share/opencode/auth.json": "deny",
            "*/.local/share/opencode/auth.json": "deny",
        },
        "glob": "allow",
        "grep": "ask",
        "list": "allow",
        "edit": "ask",
        "external_directory": {
            "*": "allow",
            "~/.ssh/**": "deny",
            "~/.gnupg/**": "deny",
            "~/.aws/**": "deny",
            "~/.azure/**": "deny",
            "~/.config/gcloud/**": "deny",
            "~/.config/gh/**": "deny",
            "~/.local/share/opencode/**": "deny",
        },
        "doom_loop": "ask",
        "playwright_*": "deny",
        "ui_screenshot": "deny",
        "ui_window_list": "deny",
        "ui_window_match": "deny",
        "task": {
            "*": "allow",
            "critical-reviewer": "deny",
        },
        "bash": {
            "*": "ask",

            "pwd": "allow",
            "whoami": "allow",
            "id": "allow",
            "groups": "allow",
            "uname": "allow",
            "uname *": "allow",
            "command -v *": "allow",
            "type *": "allow",
            "basename *": "allow",
            "dirname *": "allow",
            "readlink *": "allow",
            "realpath *": "allow",
            "bash --version*": "allow",

            "git status*": "allow",
            "git diff*": "allow",
            "git show*": "allow",
            "git log*": "allow",
            "git rev-parse*": "allow",
            "git rev-list*": "allow",
            "git blame*": "allow",
            "git for-each-ref*": "allow",
            "git count-objects -v*": "allow",
            "git submodule status*": "allow",
            "git branch --show-current": "allow",
            "git branch --list": "allow",
            "git tag --list*": "allow",
            "git describe*": "allow",
            "git name-rev*": "allow",
            "git merge-base*": "allow",
            "git ls-files*": "allow",
            "git ls-tree*": "allow",
            "git worktree list*": "allow",
            "git check-ignore*": "allow",
            "git check-attr*": "allow",
            "git stash list*": "allow",
            "git stash show*": "allow",
            "git reflog show*": "allow",
            "git --version*": "allow",

            "rustc --version*": "allow",
            "cargo --version*": "allow",
            "rustup show active-toolchain*": "allow",
            "python --version*": "allow",
            "python3 --version*": "allow",
            "uv --version*": "allow",
            "node --version*": "allow",
            "npm --version*": "allow",
            "pnpm --version*": "allow",
            "bun --version*": "allow",
            "go version*": "allow",
            "gcc --version*": "allow",
            "clang --version*": "allow",
            "cmake --version*": "allow",
            "ninja --version*": "allow",
            "dx --version*": "allow",
            "opencode --version*": "allow",
            "jq --version*": "allow",
            "shellcheck --version*": "allow",
            "shfmt --version*": "allow",

            // Read-only validators; their input paths and workspace config are trusted.
            "bash -n *": "allow",
            "shellcheck *": "allow",
            "shfmt -d *": "allow",
            "prettier --check *": "allow",

            // Read-only local diagnostics
            "pgrep -a waybar": "allow",
            "cal": "allow",
            "cal *": "allow",
            "locale": "allow",
            "locale *": "allow",
            "upower -i *": "allow",
            "upower --show-info *": "allow",
            "upower --version": "allow",
            "upower --help": "allow",
            "stat *": "allow",
            "opencode debug --help": "allow",
            "opencode debug agent * --pure": "allow",
            "opencode agent list --pure": "allow",

            // Read-only system diagnostics
            "pacman -Q *": "allow",
            "pacman -Qi *": "allow",
            "pacman -Ql *": "allow",
            "nmcli general status": "allow",
            "nmcli device status": "allow",
            "nmcli connection show --active": "allow",
            "nmcli -t -f WIFI general status": "allow",
            "nmcli -g GENERAL.STATE,GENERAL.CONNECTION device show *": "allow",
            "systemctl is-active *": "allow",
            "systemctl is-enabled *": "allow",
            "systemctl is-failed *": "allow",
            "systemctl --user is-active *": "allow",
            "systemctl --user is-enabled *": "allow",
            "systemctl --user is-failed *": "allow",
            "systemctl status * --no-pager": "allow",
            "systemctl --user status * --no-pager": "allow",
            "systemctl list-units --no-pager": "allow",
            "systemctl --user list-units --no-pager": "allow",
            "systemctl list-unit-files --no-pager": "allow",
            "systemctl --user list-unit-files --no-pager": "allow",
            "systemctl list-dependencies * --no-pager": "allow",
            "systemctl --user list-dependencies * --no-pager": "allow",
            "systemctl get-default": "allow",
            "systemctl --user get-default": "allow",
            "systemctl is-system-running": "allow",
            "systemctl --user cat espanso.service": "allow",
            "systemctl --user cat cliphist.service": "allow",
            "journalctl *--no-pager*": "allow",

            // Approval-gated Graphify command allowlist
            "graphify": "deny",
            "graphify *": "deny",
            "graphify --version": "ask",
            "graphify query *": "ask",
            "graphify explain *": "ask",
            "graphify path *": "ask",
            "graphify extract * --code-only --no-cluster": "ask",

            // Approval-gated mutation
            "rm *": "ask",
            "*/rm *": "ask",
            "rmdir *": "ask",
            "*/rmdir *": "ask",
            "chmod *": "ask",
            "*/chmod *": "ask",
            "chown *": "ask",
            "*/chown *": "ask",
            "chgrp *": "ask",
            "*/chgrp *": "ask",

            "git commit*": "ask",
            "git push*": "ask",
            "git reset --hard*": "ask",
            "git clean*": "ask",
            "git restore*": "ask",
            "git checkout --*": "ask",
            "git branch -D*": "ask",
            "git rebase*": "ask",
            "git merge*": "ask",
            "git stash drop*": "ask",
            "git stash clear*": "ask",
            "git worktree remove*": "ask",

            "gh pr merge*": "ask",
            "gh release create*": "ask",
            "gh workflow run*": "ask",

            "apt install*": "ask",
            "apt remove*": "ask",
            "apt upgrade*": "ask",
            "apt-get install*": "ask",
            "apt-get remove*": "ask",
            "apt-get upgrade*": "ask",
            "apt-get dist-upgrade*": "ask",
            "dnf install*": "ask",
            "dnf remove*": "ask",
            "dnf upgrade*": "ask",
            "pacman -S*": "ask",
            "pacman -R*": "ask",
            "pacman -U*": "ask",
            "yay -S*": "ask",
            "yay -R*": "ask",
            "paru -S*": "ask",
            "paru -R*": "ask",

            "npm install -g*": "ask",
            "npm i -g*": "ask",
            "pnpm add -g*": "ask",
            "yarn global add*": "ask",
            "bun add -g*": "ask",
            "cargo install*": "ask",
            "pip install --user*": "ask",
            "python -m pip install --user*": "ask",
            "pipx install*": "ask",
            "uv tool install*": "ask",
            "gem install*": "ask",
            "composer global require*": "ask",

            "systemctl start *": "ask",
            "systemctl stop *": "ask",
            "systemctl restart *": "ask",
            "systemctl enable *": "ask",
            "systemctl disable *": "ask",
            "systemctl mask *": "ask",
            "systemctl unmask *": "ask",
            "systemctl daemon-reload*": "ask",
            "systemctl --user start *": "ask",
            "systemctl --user stop *": "ask",
            "systemctl --user restart *": "ask",
            "systemctl --user enable *": "ask",
            "systemctl --user disable *": "ask",
            "systemctl --user mask *": "ask",
            "systemctl --user unmask *": "ask",
            "systemctl --user daemon-reload*": "ask",
            "reboot*": "ask",
            "shutdown*": "ask",
            "poweroff*": "ask",

            "docker system prune*": "ask",
            "docker volume prune*": "ask",
            "docker volume rm*": "ask",
            "docker rm*": "ask",
            "docker compose down -v*": "ask",
            "kubectl apply*": "ask",
            "kubectl delete*": "ask",
            "helm upgrade*": "ask",
            "helm uninstall*": "ask",
            "terraform apply*": "ask",

            // Family and boundary exceptions
            "bash -n *+n*": "ask",
            "bash -n *+o noexec*": "ask",
            "shfmt -d *-w*": "ask",
            "shfmt -d *--write*": "ask",
            "prettier --check *-w*": "ask",
            "prettier --check *--write*": "ask",
            "prettier --check *--cache*": "ask",
            "prettier --check *--plugin*": "ask",
            "prettier --check *--config=*": "ask",
            "prettier --check *--config *": "ask",
            "stat *--cached=never*": "ask",
            "stat *--cached never*": "ask",
            "pacman -Q *--root=*": "ask",
            "pacman -Q *--root *": "ask",
            "pacman -Q *--sysroot=*": "ask",
            "pacman -Q *--sysroot *": "ask",
            "pacman -Q *--dbpath=*": "ask",
            "pacman -Q *--dbpath *": "ask",
            "pacman -Q *--config=*": "ask",
            "pacman -Q *--config *": "ask",
            "git blame*--contents=*": "ask",
            "git blame*--contents *": "ask",
            "git blame*--ignore-revs-file=*": "ask",
            "git blame*--ignore-revs-file *": "ask",
            "git for-each-ref*--stdin*": "ask",
            "git diff*--output=*": "ask",
            "git diff*--output *": "ask",
            "git show*--output=*": "ask",
            "git show*--output *": "ask",
            "git log*--output=*": "ask",
            "git log*--output *": "ask",
            "git diff*--ext-diff*": "ask",
            "git show*--ext-diff*": "ask",
            "git log*--ext-diff*": "ask",
            "git diff*--textconv*": "ask",
            "git show*--textconv*": "ask",
            "git log*--textconv*": "ask",
            "git show*--show-signature*": "ask",
            "git log*--show-signature*": "ask",

            // Git diff, show, and log otherwise trust user and repository Git config.
            "systemctl *--root=*": "ask",
            "systemctl *--root *": "ask",
            "systemctl *--image=*": "ask",
            "systemctl *--image *": "ask",
            "systemctl *--host=*": "ask",
            "systemctl *--host *": "ask",
            "systemctl * -H *": "ask",
            "systemctl * -H*": "ask",
            "systemctl *--machine=*": "ask",
            "systemctl *--machine *": "ask",
            "systemctl * -M *": "ask",
            "systemctl * -M*": "ask",
            "systemctl *--capsule=*": "ask",
            "systemctl *--capsule *": "ask",
            "systemctl * -C *": "ask",
            "systemctl * -C*": "ask",
            "systemctl *--recursive*": "ask",
            "systemctl * -r *": "ask",
            "systemctl * -r": "ask",
            "journalctl *--directory=*": "ask",
            "journalctl *--directory *": "ask",
            "journalctl *-D *": "ask",
            "journalctl *--file=*": "ask",
            "journalctl *--file *": "ask",
            "journalctl *-i *": "ask",
            "journalctl *--root=*": "ask",
            "journalctl *--root *": "ask",
            "journalctl *--image=*": "ask",
            "journalctl *--image *": "ask",
            "journalctl *--machine=*": "ask",
            "journalctl *--machine *": "ask",
            "journalctl *-M *": "ask",
            "journalctl *--namespace=*": "ask",
            "journalctl *--namespace *": "ask",
            "journalctl *--merge*": "ask",
            "journalctl *--cursor-file=*": "ask",
            "journalctl *--cursor-file *": "ask",
            "journalctl *--flush*": "ask",
            "journalctl *--rotate*": "ask",
            "journalctl *--vacuum-*": "ask",
            "journalctl *--sync*": "ask",
            "journalctl *--synchronize-on-exit*": "ask",
            "journalctl *--relinquish-var*": "ask",
            "journalctl *--smart-relinquish-var*": "ask",
            "journalctl *--update-catalog*": "ask",
            "journalctl *--setup-keys*": "ask",

            // Explicit approved command exceptions

            // Shell composition guards
            "*;*": "ask",
            "*&&*": "ask",
            "*||*": "ask",
            "*&*": "ask",
            "*>*": "ask",
            "*<*": "ask",
            "*|*": "ask",
            "*$(*": "ask",
            "*`*": "ask",
            "tee *": "ask",

            // Explicit approved composition exceptions
            "opencode debug agent build --pure >/dev/null": "allow",
            "opencode debug agent plan --pure >/dev/null": "allow",

            // Hard deny
            "graphify update*": "deny",
            "*/graphify update*": "deny",
            "opencode debug agent *--tool*": "deny",
            "*/opencode debug agent *--tool*": "deny",
            "opencode debug agent *--params*": "deny",
            "*/opencode debug agent *--params*": "deny",
            "nmcli *--show-secrets*": "deny",
            "* nmcli *--show-secrets*": "deny",
            "nmcli -s*": "deny",
            "nmcli * -s*": "deny",
            "* nmcli * -s*": "deny",
            "nmcli *show-password*": "deny",
            "* nmcli *show-password*": "deny",
            "sudo": "deny",
            "sudo *": "deny",
            "* sudo *": "deny",
            "*/sudo *": "deny",
            "sudoedit": "deny",
            "sudoedit *": "deny",
            "* sudoedit *": "deny",
            "*/sudoedit *": "deny",
            "doas": "deny",
            "doas *": "deny",
            "* doas *": "deny",
            "*/doas *": "deny",
            "su": "deny",
            "su *": "deny",
            "* su *": "deny",
            "*/su *": "deny",
            "pkexec": "deny",
            "pkexec *": "deny",
            "* pkexec *": "deny",
            "*/pkexec *": "deny",
            "run0": "deny",
            "run0 *": "deny",
            "* run0 *": "deny",
            "*/run0 *": "deny",
            "shred *": "deny",
            "*/shred *": "deny",
            "dd *": "deny",
            "*/dd *": "deny",
            "mkfs*": "deny",
            "*/mkfs*": "deny",
            "fdisk *": "deny",
            "*/fdisk *": "deny",
            "cfdisk *": "deny",
            "*/cfdisk *": "deny",
            "sfdisk *": "deny",
            "*/sfdisk *": "deny",
            "parted *": "deny",
            "*/parted *": "deny",
            "wipefs *": "deny",
            "*/wipefs *": "deny",
            "gh release delete*": "deny",
            "gh repo delete*": "deny",
            "terraform destroy*": "deny",
            "curl *|*sh*": "deny",
            "curl *|*bash*": "deny",
            "wget *|*sh*": "deny",
            "wget *|*bash*": "deny",
        },
        "skill": {
            "*": "ask",
            "core-*": "allow",
            "project-*": "allow",
            "vendor-*": "ask",
            "experimental-*": "deny",
            "superpower-brainstorming": "allow",
            "superpower-systematic-debugging": "allow",
            "superpower-receiving-code-review": "allow",
            "superpower-dispatching-parallel-agents": "allow",
            "superpower-plan-writing": "deny",
            "superpower-skill-authoring": "deny",
            "vendor-wshobson-debugging-strategies": "allow",
            "vendor-wshobson-code-review-excellence": "allow",
            "vendor-wshobson-git-advanced-workflows": "allow",
            "vendor-wshobson-sql-optimization-patterns": "allow",
            "vendor-wshobson-visual-design-foundations": "allow",
            "vendor-wshobson-design-system-patterns": "allow",
            "vendor-wshobson-accessibility-compliance": "allow",
            "vendor-wshobson-responsive-design": "allow",
            "vendor-wshobson-interaction-design": "allow",
        },
    },
    "agent": {
        "general": {
            "hidden": true,
        },
        "explore": {
            "hidden": true,
        },
        "build": {
            "model": "openai/gpt-5.6-terra",
            "options": {
                "reasoningEffort": "medium",
            },
            "permission": {
                "edit": {
                    "*": "allow",
                    "../*": "ask",
                },
                "bash": {
                    "hyprctl configerrors": "allow",
                    "hyprctl monitors": "allow",
                    "hyprctl monitors all": "allow",
                    "hyprctl -j monitors": "allow",
                    "hyprctl -j monitors all": "allow",
                    "hyprctl clients": "allow",
                    "hyprctl -j clients": "allow",
                    "hyprctl devices": "allow",
                    "hyprctl -j devices": "allow",
                    "hyprctl activewindow": "allow",
                    "hyprctl -j activewindow": "allow",
                    "hyprctl activeworkspace": "allow",
                    "hyprctl -j activeworkspace": "allow",
                    "hyprctl workspaces": "allow",
                    "hyprctl -j workspaces": "allow",
                    "hyprctl layers": "allow",
                    "hyprctl -j layers": "allow",
                    "hyprctl version": "allow",
                    "hyprctl binds": "allow",
                    "hyprctl -j binds": "allow",
                    "hyprctl cursorpos": "allow",
                    "hyprctl -j cursorpos": "allow",
                    "hyprctl animations": "allow",
                    "hyprctl -j animations": "allow",
                    "hyprctl instances": "allow",
                    "hyprctl -j instances": "allow",
                    "hyprctl layouts": "allow",
                    "hyprctl -j layouts": "allow",
                    "playerctl -l": "allow",
                    "playerctl --list-all": "allow",
                    "playerctl status": "allow",
                    "playerctl -a status": "allow",
                    "playerctl metadata": "allow",
                    "playerctl -a metadata": "allow",
                    "playerctl metadata --format *": "allow",
                    "playerctl -a metadata --format *": "allow",
                    "playerctl position": "allow",
                    "playerctl -a position": "allow",
                    "wpctl status": "allow",
                    "wpctl inspect *": "allow",
                    "wpctl get-volume *": "allow",
                    "playerctl --help": "allow",
                    "playerctl --version": "allow",

                    // Local wildcard audio queries need their own safety tail.
                    "playerctl metadata --format *--follow*": "ask",
                    "playerctl metadata --format *-F*": "ask",
                    "playerctl -a metadata --format *--follow*": "ask",
                    "playerctl -a metadata --format *-F*": "ask",

                    "*;*": "ask",
                    "*&&*": "ask",
                    "*||*": "ask",
                    "*&*": "ask",
                    "*>*": "ask",
                    "*<*": "ask",
                    "*|*": "ask",
                    "*$(*": "ask",
                    "*`*": "ask",
                    "opencode debug agent build --pure >/dev/null": "allow",
                    "opencode debug agent plan --pure >/dev/null": "allow",

                    "graphify update*": "deny",
                    "*/graphify update*": "deny",
                    "opencode debug agent *--tool*": "deny",
                    "*/opencode debug agent *--tool*": "deny",
                    "opencode debug agent *--params*": "deny",
                    "*/opencode debug agent *--params*": "deny",
                    "nmcli *--show-secrets*": "deny",
                    "* nmcli *--show-secrets*": "deny",
                    "nmcli -s*": "deny",
                    "nmcli * -s*": "deny",
                    "* nmcli * -s*": "deny",
                    "nmcli *show-password*": "deny",
                    "* nmcli *show-password*": "deny",
                    "sudo": "deny",
                    "sudo *": "deny",
                    "* sudo *": "deny",
                    "*/sudo *": "deny",
                    "sudoedit": "deny",
                    "sudoedit *": "deny",
                    "* sudoedit *": "deny",
                    "*/sudoedit *": "deny",
                    "doas": "deny",
                    "doas *": "deny",
                    "* doas *": "deny",
                    "*/doas *": "deny",
                    "su": "deny",
                    "su *": "deny",
                    "* su *": "deny",
                    "*/su *": "deny",
                    "pkexec": "deny",
                    "pkexec *": "deny",
                    "* pkexec *": "deny",
                    "*/pkexec *": "deny",
                    "run0": "deny",
                    "run0 *": "deny",
                    "* run0 *": "deny",
                    "*/run0 *": "deny",
                    "shred *": "deny",
                    "*/shred *": "deny",
                    "dd *": "deny",
                    "*/dd *": "deny",
                    "mkfs*": "deny",
                    "*/mkfs*": "deny",
                    "fdisk *": "deny",
                    "*/fdisk *": "deny",
                    "cfdisk *": "deny",
                    "*/cfdisk *": "deny",
                    "sfdisk *": "deny",
                    "*/sfdisk *": "deny",
                    "parted *": "deny",
                    "*/parted *": "deny",
                    "wipefs *": "deny",
                    "*/wipefs *": "deny",
                    "gh release delete*": "deny",
                    "gh repo delete*": "deny",
                    "terraform destroy*": "deny",
                    "curl *|*sh*": "deny",
                    "curl *|*bash*": "deny",
                    "wget *|*sh*": "deny",
                    "wget *|*bash*": "deny",
                },
                "skill": {
                    "*": "ask",
                    "graphify": "allow",
                    "core-*": "allow",
                    "project-*": "allow",
                    "vendor-*": "ask",
                    "experimental-*": "deny",
                    "superpower-brainstorming": "allow",
                    "superpower-systematic-debugging": "allow",
                    "superpower-receiving-code-review": "allow",
                    "superpower-dispatching-parallel-agents": "allow",
                    "superpower-plan-writing": "deny",
                    "superpower-skill-authoring": "deny",
                    "vendor-wshobson-debugging-strategies": "allow",
                    "vendor-wshobson-code-review-excellence": "allow",
                    "vendor-wshobson-git-advanced-workflows": "allow",
                    "vendor-wshobson-sql-optimization-patterns": "allow",
                    "vendor-wshobson-visual-design-foundations": "allow",
                    "vendor-wshobson-design-system-patterns": "allow",
                    "vendor-wshobson-accessibility-compliance": "allow",
                    "vendor-wshobson-responsive-design": "allow",
                    "vendor-wshobson-interaction-design": "allow",
                },
            },
        },
        "plan": {
            "model": "openai/gpt-5.6-sol",
            "options": {
                "reasoningEffort": "high",
            },
            "permission": {
                "edit": "deny",
                "skill": {
                    "*": "deny",
                    "graphify": "allow",
                    "core-analysis-*": "allow",
                    "core-architecture-*": "allow",
                    "project-planning-*": "allow",
                    "superpower-plan-writing": "allow",
                    "superpower-skill-authoring": "deny",
                    "vendor-wshobson-visual-design-foundations": "allow",
                    "vendor-wshobson-design-system-patterns": "allow",
                    "vendor-wshobson-accessibility-compliance": "allow",
                    "vendor-wshobson-responsive-design": "allow",
